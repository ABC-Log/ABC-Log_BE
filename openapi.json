{
  "openapi": "3.0.3",
  "info": {
    "title": "ABCLog API",
    "version": "1.0.0",
    "description": "ABCLog 백엔드 API. 로그인 후 Authorize에 응답의 토큰을 입력하면 보호된 API를 실행할 수 있다."
  },
  "servers": [
    { "url": "http://localhost:3000", "description": "로컬 개발 서버" }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque token"
      }
    },
    "schemas": {
      "ExperienceInput": {
        "type": "object",
        "required": [
          "industry",
          "jobTitle",
          "description",
          "startedAt",
          "isCurrent"
        ],
        "properties": {
          "industry": { "type": "string", "example": "카페" },
          "jobTitle": { "type": "string", "example": "매장 직원" },
          "description": {
            "type": "string",
            "example": "주문 접수 및 고객 응대"
          },
          "startedAt": {
            "type": "string",
            "format": "date",
            "example": "2025-01-01"
          },
          "endedAt": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "example": "2025-06-30"
          },
          "isCurrent": { "type": "boolean", "example": false }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "code": { "type": "string", "example": "AUTH_REQUIRED" },
          "message": { "type": "string", "example": "로그인이 필요합니다." }
        }
      },
      "TokenPair": {
        "type": "object",
        "required": ["accessToken", "tokenType", "accessTokenExpiresAt", "refreshToken", "refreshTokenExpiresAt"],
        "properties": {
          "accessToken": { "type": "string", "description": "보호된 API 요청에 사용하는 15분 유효 토큰" },
          "tokenType": { "type": "string", "enum": ["Bearer"] },
          "accessTokenExpiresAt": { "type": "string", "format": "date-time" },
          "refreshToken": { "type": "string", "description": "갱신 요청에 사용하는 30일 유효 토큰" },
          "refreshTokenExpiresAt": { "type": "string", "format": "date-time" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "로그인되었습니다." },
          "data": {
            "allOf": [
              { "$ref": "#/components/schemas/TokenPair" },
              { "type": "object", "properties": { "userId": { "type": "string", "example": "user_1" }, "email": { "type": "string", "format": "email" }, "name": { "type": "string" } } }
            ]
          }
        }
      },
      "RefreshResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "토큰이 갱신되었습니다." },
          "data": { "$ref": "#/components/schemas/TokenPair" }
        }
      },
      "ExperienceConversionResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "message": { "type": "string", "example": "역량 변환이 완료되었습니다." },
          "data": {
            "type": "object",
            "properties": {
              "competencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "competencyId": { "type": "string", "example": "comp_001" },
                    "name": { "type": "string", "example": "의사소통" },
                    "evidence": { "type": "string", "example": "고객 응대" }
                  }
                }
              },
              "draftSentence": { "type": "string", "example": "고객의 요청을 파악해 응대하고 주문을 정확히 처리했습니다." },
              "generator": { "type": "string", "enum": ["gemini", "rules"], "example": "gemini" }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/api/users/signup": {
      "post": {
        "tags": ["회원"],
        "summary": "회원가입",
        "description": "비밀번호는 8자 이상이어야 합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password", "name"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 8,
                    "example": "password123"
                  },
                  "name": { "type": "string", "example": "홍길동" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "가입 완료" },
          "400": { "description": "입력값 오류" },
          "409": { "description": "이미 가입된 이메일" }
        }
      }
    },
    "/api/users/login": {
      "post": {
        "tags": ["회원"],
        "summary": "로그인",
        "description": "응답의 data.accessToken을 우측 상단 Authorize에 입력하세요. access token은 15분, refresh token은 30일 유효합니다. 새 로그인은 같은 계정의 이전 로그인 세션을 종료합니다.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "user@example.com"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "example": "password123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "access token과 refresh token 발급",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResponse" } } }
          },
          "401": { "description": "로그인 실패" }
        }
      }
    },
    "/api/users/refresh": {
      "post": {
        "tags": ["회원"],
        "summary": "토큰 갱신",
        "description": "사용한 refresh token은 교체됩니다. 응답의 accessToken과 refreshToken을 모두 저장하고, 이전 refresh token은 다시 사용하지 마세요.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["refreshToken"],
                "properties": {
                  "refreshToken": { "type": "string", "example": "paste-refresh-token-here" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "새 access token과 refresh token 발급. 기존 refresh token은 즉시 폐기됩니다.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RefreshResponse" } } }
          },
          "400": { "description": "refreshToken 누락" },
          "401": { "description": "refresh token 만료, 무효 또는 재사용됨" }
        }
      }
    },
    "/api/users/logout": {
      "post": {
        "tags": ["회원"],
        "summary": "로그아웃",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "현재 access token과 로그인 세션 폐기" },
          "401": { "description": "로그인 필요" }
        }
      }
    },
    "/api/experiences": {
      "get": {
        "tags": ["경험"],
        "summary": "내 경험 목록 조회",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "minimum": 1, "default": 1 }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          }
        ],
        "responses": {
          "200": { "description": "경험 목록" },
          "401": { "description": "로그인 필요" }
        }
      },
      "post": {
        "tags": ["경험"],
        "summary": "경험 등록",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExperienceInput" }
            }
          }
        },
        "responses": {
          "201": { "description": "등록 완료" },
          "200": { "description": "같은 경험이 이미 있어 기존 항목을 반환" },
          "400": { "description": "입력값 오류" },
          "401": { "description": "로그인 필요" }
        }
      }
    },
    "/api/experiences/{experienceId}": {
      "parameters": [
        {
          "name": "experienceId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "example": "exp_1" }
        }
      ],
      "get": {
        "tags": ["경험"],
        "summary": "경험 상세 조회",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "경험 상세" },
          "404": { "description": "경험 없음" },
          "401": { "description": "로그인 필요" }
        }
      },
      "patch": {
        "tags": ["경험"],
        "summary": "경험 수정",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ExperienceInput" }
            }
          }
        },
        "responses": {
          "200": { "description": "수정 완료" },
          "400": { "description": "입력값 오류" },
          "404": { "description": "경험 없음" },
          "401": { "description": "로그인 필요" }
        }
      },
      "delete": {
        "tags": ["경험"],
        "summary": "경험 삭제",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "삭제 완료" },
          "404": { "description": "경험 없음" },
          "401": { "description": "로그인 필요" }
        }
      }
    },
    "/api/experiences/{experienceId}/conversions": {
      "parameters": [
        {
          "name": "experienceId",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "example": "exp_1" }
        }
      ],
      "post": {
        "tags": ["역량 변환"],
        "summary": "경험 기반 역량 변환",
        "description": "Gemini로 입력 경험을 역량과 문장 초안으로 변환합니다. Gemini를 사용할 수 없으면 규칙 기반으로 처리합니다. 입력에 없는 내용은 생성하지 않도록 제한하며, 변환 결과는 저장하지 않습니다.",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "역량과 문장 초안. data.generator는 gemini 또는 rules입니다.",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ExperienceConversionResponse" } } }
          },
          "404": { "description": "경험 없음" },
          "401": { "description": "로그인 필요" }
        }
      },
      "get": {
        "tags": ["역량 변환"],
        "summary": "저장된 변환 결과 조회",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "변환 결과 목록" },
          "404": { "description": "경험 없음" },
          "401": { "description": "로그인 필요" }
        }
      }
    },
    "/api/conversions": {
      "post": {
        "tags": ["역량 변환"],
        "summary": "변환 결과 저장",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "experienceId",
                  "draftSentence"
                ],
                "anyOf": [
                  { "required": ["competencyIds"] },
                  { "required": ["competencies"] }
                ],
                "properties": {
                  "experienceId": { "type": "string", "example": "exp_1" },
                  "competencyIds": {
                    "type": "array",
                    "items": { "type": "string" },
                    "example": ["comp_001", "comp_003"]
                  },
                  "competencies": {
                    "type": "array",
                    "description": "경험 기반 변환 API 응답을 그대로 전달할 때 사용",
                    "items": {
                      "type": "object",
                      "required": ["competencyId"],
                      "properties": { "competencyId": { "type": "string" } }
                    }
                  },
                  "draftSentence": {
                    "type": "string",
                    "maxLength": 1000,
                    "example": "카페 근무를 통해 고객 응대 경험을 쌓았습니다."
                  },
                  "finalSentence": {
                    "type": "string",
                    "maxLength": 1000,
                    "example": "카페에서 고객 응대와 주문 처리를 담당했습니다."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "저장 완료" },
          "400": { "description": "입력값 오류" },
          "401": { "description": "로그인 필요" }
        }
      }
    },
    "/api/conversions/{conversionId}": {
      "patch": {
        "tags": ["역량 변환"],
        "summary": "최종 문장 수정",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          {
            "name": "conversionId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "example": "conv_1" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["finalSentence"],
                "properties": {
                  "finalSentence": {
                    "type": "string",
                    "maxLength": 1000,
                    "example": "카페에서 고객 응대와 주문 처리를 담당했습니다."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "수정 완료" },
          "404": { "description": "변환 결과 없음" },
          "401": { "description": "로그인 필요" }
        }
      }
    },
    "/api/competencies": {
      "get": {
        "tags": ["기준 정보"],
        "summary": "역량 목록 조회",
        "responses": { "200": { "description": "역량 목록" } }
      }
    },
    "/api/jobs/catalog": {
      "get": {
        "tags": ["직무"],
        "summary": "직무 기준 데이터 조회",
        "responses": { "200": { "description": "직무 목록" } }
      }
    },
    "/api/jobs/recommendations": {
      "get": {
        "tags": ["직무"],
        "summary": "역량 기반 직무 추천",
        "parameters": [
          {
            "name": "competencyIds",
            "in": "query",
            "required": true,
            "description": "쉼표로 구분한 역량 ID",
            "schema": { "type": "string", "example": "comp_001,comp_003" }
          }
        ],
        "responses": {
          "200": { "description": "추천 직무 목록" },
          "400": { "description": "역량 선택 오류" }
        }
      }
    },
    "/api/labor-guides": {
      "get": {
        "tags": ["근로조건"],
        "summary": "근로조건 점검 정보 조회",
        "parameters": [
          {
            "name": "topic",
            "in": "query",
            "description": "contract, payslip, wage, workHours, breakTime 중 하나",
            "schema": {
              "type": "string",
              "enum": ["contract", "payslip", "wage", "workHours", "breakTime"]
            }
          }
        ],
        "responses": {
          "200": { "description": "근로조건 안내 목록" },
          "400": { "description": "지원하지 않는 주제" }
        }
      }
    }
  }
}
